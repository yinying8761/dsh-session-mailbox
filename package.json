    "url": "git+https://github.com/yinying8761/dsh-session-mailbox.git"
  },
  "bugs": {
    "url": "https://github.com/yinying8761/dsh-session-mailbox/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent",
    "session",
    "multi-agent",
    "messaging",
    "mailbox"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
